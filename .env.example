# Configure only in Vercel Project Settings > Environment Variables.
# Do not use VITE_ for any value below: VITE_ variables are shipped to browsers.

NOCODB_BASE_URL=https://your-nocodb-host.example
NOCODB_API_TOKEN=replace-with-a-new-private-nocodb-token
NOCODB_LEADS_TABLE_ID=replace-with-leads-table-id
NOCODB_FOLLOWUP_TEMPLATES_TABLE_ID=replace-with-templates-table-id
NOCODB_FOLLOWUP_SCHEDULES_TABLE_ID=replace-with-schedules-table-id
NOCODB_FOLLOWUP_EVENTS_TABLE_ID=replace-with-events-table-id

# Used only when the Evolution API webhook is connected.
EVOLUTION_WEBHOOK_SECRET=generate-a-long-random-value
