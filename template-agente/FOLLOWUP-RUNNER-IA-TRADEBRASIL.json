      "id": "f108-cancelar-evento",
      "name": "Marcar Evento Cancelado",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1640,
        600
      ]
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst lead = data.lead;\nconst ev = data.evento;\n\nconst promptSistema = `Você é o Consultor de Relacionamento da TradeBrasil Agro (mesa de operações agrícolas e proteção de safra / hedge).\n\nSua missão é gerar uma mensagem ÚNICA, CURTA e INÉDITA de WhatsApp (máximo 2 a 3 frases) para follow-up com este produtor rural.\n\nDIRETRIZES FUNDAMENTAIS:\n1. Comece de forma natural e amigável: \"Oi ${lead.primeiro_nome}!\" ou \"Olá ${lead.primeiro_nome}, tudo bem?\".\n2. Conecte com a realidade dele: ele produz ${lead.cultura_principal} em ${lead.estado}${lead.volume_safra ? ' com volume de ' + lead.volume_safra : ''}.\n3. Traga um gancho atual de mercado: oscilação recente de preços na bolsa (B3/Chicago), dólar, momento de garantir os custos de produção da safra ou relação de troca em insumos.\n4. NUNCA envie termos técnicos de robô, nem tente fechar contrato por mensagem.\n5. Finalize convidando para uma ligação rápida de 5 minutos com o consultor da mesa de operações para tirar dúvidas ou fazer uma simulação de trava sem compromisso.\n6. Responda EXCLUSIVAMENTE o texto puro da mensagem de WhatsApp, sem aspas, sem explicações e sem tags de código.`;\n\nconst promptUsuario = `PRODUTOR:\nNome: ${lead.nome}\nCultura: ${lead.cultura_principal}\nEstado: ${lead.estado}\nVolume: ${lead.volume_safra || lead.volume_bois || 'Não informado'}\nÚltimo contato: ${lead.ultimo_envio || 'Primeiro contato da cadência'}\nHistórico anterior: ${lead.resumo_conversa || 'Nenhum'}`;\n\nreturn [{\n  json: {\n    ...data,\n    prompt_sistema: promptSistema,\n    prompt_usuario: promptUsuario\n  }\n}];"
      },
