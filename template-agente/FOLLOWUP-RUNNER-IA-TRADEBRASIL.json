      "id": "f105-buscar-lead",
      "name": "Buscar Lead no NocoDB",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        980,
        420
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const lead = $input.first().json || {};\nconst evento = $('Loop Sobre Eventos').item.json;\n\n// Validações\nconst telefoneValido = Boolean(lead.telefone && String(lead.telefone).replace(/\\D/g, '').length >= 10);\nconst jaRespondeu = lead.followup_status === 'respondido';\nconst emAtendimento = lead.em_atendimento === true || lead.em_atendimento === 1;\nconst aguardandoEspecialista = lead.aguardando_especialista === true || lead.aguardando_especialista === 1;\n\nconst elegivel = telefoneValido && !jaRespondeu && !emAtendimento && !aguardandoEspecialista;\n\nlet motivoIneligivel = '';\nif (!telefoneValido) motivoIneligivel = 'Telefone inválido ou ausente';\nelse if (jaRespondeu) motivoIneligivel = 'Lead já respondeu anteriormente';\nelse if (emAtendimento) motivoIneligivel = 'Lead já em atendimento ativo com SDR';\nelse if (aguardandoEspecialista) motivoIneligivel = 'Lead já agendado com especialista';\n\nreturn [{\n  json: {\n    elegivel,\n    motivoIneligivel,\n    evento,\n    lead: {\n      id: lead.Id,\n      nome: lead.nome || 'Produtor',\n      primeiro_nome: (lead.nome || 'Produtor').split(' ')[0],\n      telefone: String(lead.telefone || '').replace(/\\D/g, ''),\n      cultura_principal: lead.cultura_principal || 'Soja e Milho',\n      volume_safra: lead.volume_safra || '',\n      volume_bois: lead.volume_bois || '',\n      estado: lead.estado || 'sua região',\n      resumo_conversa: lead.resumo_conversa || '',\n      ultimo_envio: lead.followup_ultimo_envio_em || null\n    }\n  }\n}];"
      },
