        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"Id\": {{ $json.evento.Id }},\n  \"status\": \"cancelado\",\n  \"erro\": \"Cancelado automaticamente: {{ $json.motivoIneligivel }}\",\n  \"executado_em\": \"{{ $now.setZone('UTC').toFormat('yyyy-MM-dd HH:mm:ss') }}\"\n}",
