    {
      "parameters": {
        "jsCode": "const aiRaw = $input.first().json.text || '';\nconst prevData = $('Preparar Prompt IA').first().json;\n\nlet cleanedMessage = aiRaw\n  .replace(/^[\"']|[\"']$/g, '')\n  .replace(/^\\x60\\x60\\x60json\\s*/im, '')\n  .replace(/^\\x60\\x60\\x60\\s*/im, '')\n  .replace(/\\s*\\x60\\x60\\x60$/m, '')\n  .trim();\n\n// Se por algum motivo a IA cuspiu JSON com campo mensagem_whatsapp\ntry {\n  const jsonMatch = cleanedMessage.match(/\\{[\\s\\S]*\\}/);\n  if (jsonMatch) {\n    const parsed = JSON.parse(jsonMatch[0]);\n    if (parsed.mensagem_whatsapp) cleanedMessage = parsed.mensagem_whatsapp;\n  }\n} catch(e) {}\n\nreturn [{\n  json: {\n    ...prevData,\n    mensagem_gerada: cleanedMessage\n  }\n}];"
      },
